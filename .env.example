# Expense - AI Tracker (Google Play account deletion page)
# Copy to `.env` and fill with your Firebase + Render API values.

# Backend API (no trailing slash)
VITE_EXPENSE_API_BASE_URL=https://YOUR-RENDER-API.onrender.com

# Firebase project for Expense - AI Tracker
VITE_EXPENSE_FIREBASE_API_KEY=
VITE_EXPENSE_FIREBASE_AUTH_DOMAIN=
VITE_EXPENSE_FIREBASE_PROJECT_ID=
VITE_EXPENSE_FIREBASE_STORAGE_BUCKET=
VITE_EXPENSE_FIREBASE_MESSAGING_SENDER_ID=
VITE_EXPENSE_FIREBASE_APP_ID=
